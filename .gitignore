# Python
venv/
__pycache__/
*.pyc

# Compiled libraries: the XFOILAD Windows DLLs are distributed as a GitHub
# release asset (xfoilad-win64.zip), others are built locally; the IPOPT
# binaries (optional) are downloaded by the user
xfoilad/lib/*.dll
xfoilad/lib/*.so
xfoilad/lib/*.dylib
xfoilad/lib/ipopt/

# Fortran build products
*.o
*.mod
*.a

# User guide: only the PDF is published (LaTeX source, figures and tables
# generated by the example cases stay local)
docs/user_guide.tex
docs/guide/figs/
docs/guide/out/
docs/guide/run_cases.py
docs/guide/make_tables.py
*.aux
*.toc

# Outputs of examples
*.log
fortran/build/
fortran/build_tgt/
