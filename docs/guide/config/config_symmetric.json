{
  "airfoil": {"naca": "0012"},
  "parametrization": {"type": "bspline", "n_ctrl": 10, "symmetric": true},
  "objective": "cd",
  "points": [
    {"cl": 0.2, "re": 1e6, "tu": 0.1, "name": "course"},
    {"cl": 0.4, "re": 1e6, "tu": 0.1, "name": "turn", "weight": 0.5},
    {"cl": 0.9, "re": 6e5, "tu": 0.3, "name": "manoeuvre", "in_objective": false}
